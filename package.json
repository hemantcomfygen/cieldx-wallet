{
  "name": "cieldx-wallet",
  "version": "1.0.3",
  "description": "CieldX Wallet is a secure, non-custodial crypto wallet that lets users manage digital assets, interact with decentralized applications (dApps), and perform seamless cross-chain transactions—all in one place.",
  "main": "./out/main/index.js",
  "author": {
    "name": "CieldX",
    "email": "your@email.com"
  },
  "homepage": "https://electron-vite.org",
  "build": {
    "appId": "com.cieldx.wallet",
    "productName": "CieldXWallet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hemantcomfygen",
        "repo": "cieldx-wallet"
      }
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@orbs-network/ton-access": "^2.3.3",
    "@reduxjs/toolkit": "^2.11.1",
    "@scure/bip32": "^2.0.1",
    "@solana/kit": "^6.8.0",
    "@solana/web3.js": "^1.98.4",
    "@stellar/stellar-sdk": "^15.0.1",
    "@tailwindcss/vite": "^4.1.17",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.2.4",
    "@ton/walletkit": "^0.0.11",
    "aos": "^2.3.4",
    "apexcharts": "^5.3.6",
    "axios": "^1.13.2",
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "bitcore-lib": "^10.10.7",
    "bitcore-mnemonic": "^10.10.7",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "ecpair": "^3.0.1",
    "ed25519-hd-key": "^1.3.0",
    "electron-updater": "^6.3.9",
    "emotion": "^11.0.0",
    "ethers": "^6.16.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.12.1",
    "hdkey": "^2.1.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.562.0",
    "node-fetch": "^3.3.2",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "react-apexcharts": "^1.9.0",
    "react-awesome-reveal": "^4.3.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.10.1",
    "react-slick": "^0.31.0",
    "redux-persist": "^6.0.0",
    "slick-carousel": "^1.8.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.16",
    "tiny-secp256k1": "^2.2.4",
    "tronweb": "^6.2.2",
    "uuid": "^13.0.0",
    "vite-plugin-node-polyfills": "^0.26.0",
